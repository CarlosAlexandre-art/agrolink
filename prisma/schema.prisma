generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  PRODUTOR
  PRESTADOR
}

enum ServiceType {
  // Mecanização
  PULVERIZACAO
  COLHEITA
  PLANTIO
  TRATORACAO
  APLICACAO_FERTILIZANTES
  // Lavoura & Solo
  ANALISE_SOLO
  ANALISE_SOLO_AVANCADA
  CONSULTORIA_AGRONOMICA
  CONTROLE_PRAGAS
  CAPINA
  IRRIGACAO
  IRRIGACAO_AUTOMATIZADA
  FUMIGACAO
  // Tecnologia
  DRONE_AGRICOLA
  APLICACAO_DRONE
  GEORREFERENCIAMENTO
  MONITORAMENTO_SATELITE
  AGRICULTURA_PRECISAO
  TOPOGRAFIA
  SENSORIAMENTO_REMOTO
  // Pecuária
  ASSISTENCIA_VETERINARIA
  INSEMINACAO
  // Infraestrutura
  CERCAMENTO
  TERRAPLANAGEM
  ARMAZENAGEM
  CONSTRUCAO_RURAL
  INSTALACAO_PIVO
  ENERGIA_SOLAR_RURAL
  BIOGAS_RURAL
  // Ambiental / Legal
  GESTAO_AMBIENTAL
  REGULARIZACAO_FUNDIARIA
  CERTIFICACAO_AGRICOLA
  LICENCIAMENTO_AMBIENTAL
  RASTREABILIDADE
  // Manutenção
  MANUTENCAO_MAQUINAS
  MANUTENCAO_COLHEITADEIRA
  // Segurança
  SEGURANCA_RURAL
  // Logística
  TRANSPORTE
  TRANSPORTE_GRAOS
  // Outros
  OUTROS
}

enum ServiceStatus {
  AGUARDANDO
  PROCURANDO
  AGUARDANDO_PROPOSTA
  MATCH_ENCONTRADO
  EM_ROTA
  EXECUTANDO
  CONCLUIDO
  CANCELADO
  DISPUTA
}

enum MatchStatus {
  PENDENTE
  ACEITO
  RECUSADO
  CANCELADO
}

enum PaymentStatus {
  PENDENTE
  RESERVADO
  LIBERADO
  REEMBOLSADO
}

model User {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  nome       String
  email      String   @unique
  telefone   String?
  cpf        String?
  tipo       UserType
  avatarUrl  String?
  estado     String?
  cidade     String?
  latitude   Float?
  longitude  Float?
  plan       String   @default("free")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  produtor          Produtor?
  prestador         Prestador?
  pushSubscriptions PushSubscription[]
  mensagens         Mensagem[]
  organizationMemberships OrganizationMember[]
  investorProfiles        InvestorProfile[]
  offeringEvents          OfferingEvent[]
  complianceLogs          ComplianceLog[]
  uploadedOfferingDocuments OfferingDocument[]
  agentConfigs      AgentConfig[]
}

model AgentConfig {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome         String
  role         String
  tipo         String      @default("CUSTOMIZADO")
  systemPrompt String?
  tools        String[]
  trigger      String      @default("MANUAL")
  ativo        Boolean     @default(true)
  createdAt    DateTime    @default(now())
  runs         AgentRun[]

  @@index([userId])
}

model AgentRun {
  id          String      @id @default(cuid())
  agentId     String
  agent       AgentConfig @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String
  status      String      @default("RUNNING")
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  resultado   String?
  toolCalls   String?
  erro        String?

  @@index([agentId])
}

model Produtor {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  nomeFazenda        String?
  areaTotal          Float?
  avaliacao          Float     @default(0)
  totalAvaliacoes    Int       @default(0)
  verificado         Boolean   @default(false)
  verificadoEm       DateTime?
  cpfVerificado      Boolean   @default(false)
  docVerificado      Boolean   @default(false)
  telefoneVerificado Boolean   @default(false)
  services           Service[]
  avaliacoesRecebidas AvaliacaoProdutor[]
  createdAt          DateTime  @default(now())
}

model Prestador {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id])
  bio                String?
  avaliacao          Float         @default(0)
  totalAvaliacoes    Int           @default(0)
  disponivel         Boolean       @default(true)
  raioAtendamento    Int           @default(50)
  stripeAccountId    String?
  verificado         Boolean       @default(false)
  verificadoEm       DateTime?
  cpfVerificado      Boolean       @default(false)
  docVerificado      Boolean       @default(false)
  telefoneVerificado Boolean       @default(false)
  servicosOferecidos ServiceType[]
  matches            Match[]
  avaliacoes         Avaliacao[]
  createdAt          DateTime      @default(now())
}

model Service {
  id            String        @id @default(cuid())
  produtorId    String
  produtor      Produtor      @relation(fields: [produtorId], references: [id])
  tipo          ServiceType
  descricao     String?
  area          Float?
  urgencia      String        @default("MEDIA")
  status        ServiceStatus @default(AGUARDANDO)
  latitude      Float
  longitude     Float
  endereco      String?
  precoEstimado Float?
  precoFinal    Float?
  agendadoPara  DateTime?
  fotoProva     String?
  gpsLat        Float?
  gpsLng        Float?
  contratoUrl         String?
  contratoAceitoEm    DateTime?
  contratoIpProdutor  String?
  contratoIpPrestador String?
  disputa           Disputa?
  matches           Match[]
  payment           Payment?
  avaliacao         Avaliacao?
  avaliacaoProdutor AvaliacaoProdutor?
  mensagens         Mensagem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Match {
  id             String      @id @default(cuid())
  serviceId      String
  service        Service     @relation(fields: [serviceId], references: [id])
  prestadorId    String
  prestador      Prestador   @relation(fields: [prestadorId], references: [id])
  status         MatchStatus @default(PENDENTE)
  distancia      Float?
  valorProposto  Float?
  mensagemProposta String?
  smartScore     Float?
  smartReason    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([serviceId, prestadorId])
}

model Disputa {
  id          String        @id @default(cuid())
  serviceId   String        @unique
  service     Service       @relation(fields: [serviceId], references: [id])
  abertaPor   String        // userId de quem abriu
  motivo      String
  descricao   String
  status      DisputaStatus @default(ABERTA)
  resolucao   String?
  evidencias  String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum DisputaStatus {
  ABERTA
  EM_ANALISE
  RESOLVIDA_PRODUTOR
  RESOLVIDA_PRESTADOR
  ENCERRADA
}

model Payment {
  id               String        @id @default(cuid())
  serviceId        String        @unique
  service          Service       @relation(fields: [serviceId], references: [id])
  valor            Float
  comissao         Float
  valorPrestador   Float
  status           PaymentStatus @default(PENDENTE)
  stripePaymentId  String?
  stripeTransferId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Avaliacao {
  id          String    @id @default(cuid())
  serviceId   String    @unique
  service     Service   @relation(fields: [serviceId], references: [id])
  prestadorId String
  prestador   Prestador @relation(fields: [prestadorId], references: [id])
  nota        Int
  peso        Float     @default(1.0)
  comentario  String?
  contestacao        String?
  contestacaoStatus  String?
  contestacaoEm      DateTime?
  createdAt   DateTime  @default(now())
}

model AvaliacaoProdutor {
  id         String   @id @default(cuid())
  serviceId  String   @unique
  service    Service  @relation(fields: [serviceId], references: [id])
  produtorId String
  produtor   Produtor @relation(fields: [produtorId], references: [id])
  nota       Int
  peso       Float    @default(1.0)
  comentario String?
  contestacao        String?
  contestacaoStatus  String?
  contestacaoEm      DateTime?
  createdAt  DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Mensagem {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id])
  remetenteId String
  remetente   User     @relation(fields: [remetenteId], references: [id])
  texto       String
  createdAt   DateTime @default(now())

  @@index([serviceId, createdAt])
}

model Denuncia {
  id               String   @id @default(cuid())
  denuncianteId    String?
  denuncianteEmail String?
  motivo           String
  descricao        String
  emailDenunciado  String?
  createdAt        DateTime @default(now())
}

enum OrganizationRole {
  OWNER
  ADMIN
  OPERATOR
  PARTNER_VIEWER
  INVESTOR
}

enum OfferingStatus {
  DRAFT
  UNDER_REVIEW
  READY
  ACTIVE
  CLOSED
  SETTLED
  ARCHIVED
}

enum AssetCategory {
  REAL_ESTATE
  RECEIVABLE
  CREDIT
  EQUITY
  OTHER
}

enum DocumentCategory {
  TERM_SHEET
  LEGAL
  ASSET_EVIDENCE
  INVESTOR_MATERIAL
  REPORT
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  PARTNER
  INVESTOR
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  REJECTED
}

enum InvestorOnboardingStatus {
  LEAD
  INVITED
  IN_REVIEW
  ACTIVE
  BLOCKED
}

enum AllocationStatus {
  PENDING
  RESERVED
  CONFIRMED
  CANCELLED
  SETTLED
}

enum EventVisibility {
  INTERNAL
  PARTNER
  INVESTOR
}

enum OfferingEventType {
  OPERATION_CREATED
  DOCUMENT_APPROVED
  INVESTOR_ADDED
  ALLOCATION_CONFIRMED
  DISTRIBUTION_RECORDED
  NOTICE_PUBLISHED
  STATUS_CHANGED
}

enum DistributionStatus {
  DRAFT
  SCHEDULED
  PROCESSED
  CANCELLED
}

enum DistributionEntryStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

model Organization {
  id          String               @id @default(cuid())
  nome        String
  slug        String               @unique
  tipo        String?
  logoUrl     String?
  corPrimaria String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  members          OrganizationMember[]
  offerings        Offering[]
  investorProfiles InvestorProfile[]
  complianceLogs   ComplianceLog[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  @@unique([organizationId, userId])
}

model Offering {
  id           String         @id @default(cuid())
  organizationId String
  organization Organization   @relation(fields: [organizationId], references: [id])
  nome         String
  slug         String         @unique
  tipo         String?
  status       OfferingStatus @default(DRAFT)
  resumo       String?
  moeda        String         @default("BRL")
  ticketMinimo Decimal?       @db.Decimal(18, 2)
  targetRaise  Decimal?       @db.Decimal(18, 2)
  openedAt     DateTime?
  closedAt     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assets        Asset[]
  documents     OfferingDocument[]
  allocations   Allocation[]
  events        OfferingEvent[]
  distributions Distribution[]
}

model Asset {
  id                 String        @id @default(cuid())
  offeringId         String
  offering           Offering      @relation(fields: [offeringId], references: [id])
  nome               String
  categoria          AssetCategory @default(OTHER)
  descricao          String?
  origem             String?
  valuationReference String?
  metadataJson       Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents OfferingDocument[]
}

model OfferingDocument {
  id           String             @id @default(cuid())
  offeringId   String
  offering     Offering           @relation(fields: [offeringId], references: [id])
  assetId      String?
  asset        Asset?             @relation(fields: [assetId], references: [id])
  nome         String
  categoria    DocumentCategory   @default(OTHER)
  storageKey   String
  mimeType     String?
  visibilidade DocumentVisibility @default(INTERNAL)
  status       DocumentStatus     @default(DRAFT)
  version      Int                @default(1)
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime           @default(now())
}

model InvestorProfile {
  id               String                   @id @default(cuid())
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id])
  userId           String?
  user             User?                    @relation(fields: [userId], references: [id])
  nomeCompleto     String
  email            String
  telefone         String?
  taxId            String?
  onboardingStatus InvestorOnboardingStatus @default(LEAD)
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  allocations Allocation[]

  @@index([organizationId, email])
}

model Allocation {
  id                String           @id @default(cuid())
  offeringId        String
  offering          Offering         @relation(fields: [offeringId], references: [id])
  investorProfileId String
  investorProfile   InvestorProfile  @relation(fields: [investorProfileId], references: [id])
  className         String?
  investedAmount    Decimal?         @db.Decimal(18, 2)
  quantity          Decimal?         @db.Decimal(18, 6)
  unitPrice         Decimal?         @db.Decimal(18, 6)
  status            AllocationStatus @default(PENDING)
  subscribedAt      DateTime?
  settledAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  distributionEntries DistributionEntry[]
}

model OfferingEvent {
  id          String            @id @default(cuid())
  offeringId  String
  offering    Offering          @relation(fields: [offeringId], references: [id])
  tipo        OfferingEventType
  titulo      String
  descricao   String?
  effectiveAt DateTime?
  visibility  EventVisibility   @default(INTERNAL)
  createdById String?
  createdBy   User?             @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
}

model ComplianceLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id])
  entityType     String
  entityId       String
  action         String
  payloadJson    Json?
  createdAt      DateTime     @default(now())
}

model Distribution {
  id              String             @id @default(cuid())
  offeringId      String
  offering        Offering           @relation(fields: [offeringId], references: [id])
  referencePeriod String?
  grossAmount     Decimal?           @db.Decimal(18, 2)
  netAmount       Decimal?           @db.Decimal(18, 2)
  status          DistributionStatus @default(DRAFT)
  createdAt       DateTime           @default(now())

  entries DistributionEntry[]
}

model DistributionEntry {
  id             String                  @id @default(cuid())
  distributionId String
  distribution   Distribution            @relation(fields: [distributionId], references: [id])
  allocationId   String
  allocation     Allocation              @relation(fields: [allocationId], references: [id])
  amount         Decimal?                @db.Decimal(18, 2)
  status         DistributionEntryStatus @default(PENDING)
}
